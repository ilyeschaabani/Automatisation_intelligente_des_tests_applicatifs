OPENROUTER_API_KEY=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

# OpenRouter model to use (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# OpenRouter API base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM confidence threshold (use LLM for endpoints below this)
LLM_CONFIDENCE_THRESHOLD=0.75

# Maximum file size for chunking (bytes)
MAX_FILE_SIZE=100000

# Number of parallel workers
MAX_WORKERS=4

# Cache TTL (seconds)
CACHE_TTL=3600

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
OPENROUTER_API_KEY=ollama 

# OpenRouter model to use (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=qwen2.5-coder:7b

# OpenRouter API base URL
OPENROUTER_BASE_URL=http://localhost:11434/v1

# LLM confidence threshold (use LLM for endpoints below this)
LLM_CONFIDENCE_THRESHOLD=0.75

# Maximum file size for chunking (bytes)
MAX_FILE_SIZE=100000

# Number of parallel workers
MAX_WORKERS=4

# Cache TTL (seconds)
CACHE_TTL=3600

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# -------------------------
# Local LLM (Option C)
# -------------------------
# Force local-only LLM usage (Ollama/vLLM/TGI). This overrides cloud providers.
LLM_PROVIDER=local

# Ollama OpenAI-compatible endpoint
LLM_BASE_URL=http://localhost:11434/v1

# Many local servers accept any non-empty key
LLM_API_KEY=local

# Local model name (Ollama)
LLM_MODEL=qwen2.5-coder:7b

# Force Stage 3 to call the local LLM even when there are no low-confidence endpoints.
LLM_FORCE=1
LLM_FORCE_MAX_FILES=3
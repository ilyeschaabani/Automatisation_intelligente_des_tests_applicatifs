# Example environment configuration for github-discovery
# Copy to .env and adjust values.

# -------------------------
# LLM (optional augmentation)
# -------------------------

# Provider selection:
# - auto (default): prefer LLM_BASE_URL, then OPENROUTER_API_KEY, then OPENAI_API_KEY
# - local: use a local OpenAI-compatible server (Ollama/vLLM/TGI)
# - openrouter: use OpenRouter cloud
# - openai: use OpenAI cloud
# - none: disable LLM calls
LLM_PROVIDER=local

# Local OpenAI-compatible base URL:
# - Ollama: http://localhost:11434/v1
# - vLLM:   http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1

# Many local servers accept any non-empty API key.
LLM_API_KEY=local

# Model name:
# - Ollama example: qwen2.5-coder:7b
# - vLLM example:   Qwen/Qwen2.5-Coder-7B-Instruct
LLM_MODEL=qwen2.5-coder:7b

# OpenRouter (cloud)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (cloud)
# OPENAI_API_KEY=

# Use LLM for endpoints below this confidence
LLM_CONFIDENCE_THRESHOLD=0.75

# -------------------------
# Processing
# -------------------------
MAX_FILE_SIZE=100000
MAX_WORKERS=4
CACHE_TTL=3600
LOG_LEVEL=INFO

# Paths (optional)
# REPOS_DIR=repos
# OUTPUT_DIR=output
